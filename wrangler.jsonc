{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayforge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Una partida = un Durable Object Sala: guarda el estado en su SQLite y reparte los cambios por WebSocket
  "durable_objects": { "bindings": [{ "name": "SALAS", "class_name": "Sala" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }],
  // Imágenes de mapas y tokens en Workers KV (gratis, sin activar nada; hasta 25 MB por imagen).
  // Si algún día se activa R2 en la cuenta, basta con agregar:
  //   "r2_buckets": [{ "binding": "IMAGENES", "bucket_name": "wayforge-imagenes" }]
  // y el Worker las guarda ahí en lugar de KV. En local, wrangler simula ambos en .wrangler/
  "kv_namespaces": [{ "binding": "IMAGENES_KV", "id": "3a4a737496e64ad3964ed9ca5a2ae414" }]
}
